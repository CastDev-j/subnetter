---
import SubnetCalculator from "../components/SubnetCalculator";
import "../styles/global.css";

---

<html lang="es">
	<head>
		<meta charset="utf-8" />
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		<link rel="icon" href="/favicon.ico" />
		<meta name="viewport" content="width=device-width" />
		<meta name="generator" content={Astro.generator} />
		<meta name="theme-color" content="#ffffff" />
		<meta name="robots" content="index, follow" />
		<meta name="language" content="es" />
		
		<title>Calculadora de Subredes IP</title>
		<meta name="description" content="Calculadora de Subredes IPv4 online gratis. Calcula subredes, máscaras de red, rangos de IPs y convierte entre notaciones CIDR y decimal." />
		<meta name="keywords" content="calculadora subredes, IPv4, CIDR, máscara de red, redes, subnetting, calculadora IP" />
		<meta name="author" content="Subnetter" />
		
		<meta property="og:type" content="website" />
		<meta property="og:title" content="Calculadora de Subredes IP" />
		<meta property="og:description" content="Calcula subredes IPv4, máscaras de red y rangos de IPs al instante." />
		<meta property="og:image" content="/og.png" />
		<meta property="og:image:width" content="1200" />
		<meta property="og:image:height" content="630" />
		<meta property="og:image:alt" content="Calculadora de Subredes IPv4" />
		<meta property="og:url" content="https://subnetter.com" />
		<meta property="og:site_name" content="Subnetter" />
		<meta property="og:locale" content="es_ES" />
		
		<meta name="twitter:card" content="summary_large_image" />
		<meta name="twitter:title" content="Calculadora de Subredes IP" />
		<meta name="twitter:description" content="Calcula subredes IPv4, máscaras de red y rangos de IPs al instante." />
		<meta name="twitter:image" content="/og.png" />
		<meta name="twitter:image:alt" content="Calculadora de Subredes IPv4" />
	</head>
	<body>
		<SubnetCalculator client:load/>
	</body>
</html>
